<?xml version="1.0" encoding="UTF-8"?>
<!--
  Destination: apps/web/public/web.config
  (Vite copies everything in public/ verbatim into dist/ on every build, so this
  file automatically travels with the normal deploy routine — Remove-Item
  wwwroot\* + Copy-Item dist\* — instead of needing to be dropped into wwwroot by
  hand and re-added every time a rebuild wipes it out.)

  Reverse-proxies /api/* to the Node API (BenAdminAPI, nssm-managed, listening on
  localhost:3000) using IIS's Application Request Routing proxy feature, which was
  already confirmed enabled server-wide (<proxy enabled="true" .../> in
  applicationHost.config) but had no actual rule wiring it up to this site — every
  /api/* request was falling through to IIS's static-file handler and 404ing before
  ever reaching Node. This rule is what was missing.

  Everything else (the React app's own files, client-side routing) is left alone —
  the rule only matches paths starting with "api/".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNodeAPI" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3000/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>